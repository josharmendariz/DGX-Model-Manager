[Unit]
Description=DGX Model Manager (LLM engine control UI, port 8090)
Documentation=https://github.com/josharmendariz/DGX-Model-Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/DGX-Model-Manager
# Tailnet-private deployment: bound to the Tailscale IP only (config.json
# app.host), same trust model as hermes-webui — so unauthenticated access
# inside the tailnet is acknowledged.
Environment=MODEL_MANAGER_ALLOW_UNAUTH=1
# Wait for tailscale0 to carry an IPv4 address before binding to it (tailscaled
# is a system service we can't order against from a --user unit). Give up after
# ~60s and let the bind fail — Restart=always will retry.
ExecStartPre=/bin/sh -c 'for i in $$(seq 1 60); do [ -n "$$(ip -4 -o addr show tailscale0 2>/dev/null)" ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/python3 %h/DGX-Model-Manager/app.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0
# Health-gate the restart loop — / serves the UI without auth. Resolve the bind
# address at runtime so this unit is host-agnostic; fall back to loopback for
# non-tailnet deployments.
ExecStartPost=/bin/sh -c 'IP=$$(tailscale ip -4 2>/dev/null | head -1); [ -n "$$IP" ] || IP=127.0.0.1; for i in $$(seq 1 30); do curl -sf "http://$$IP:8090/" >/dev/null && exit 0; sleep 1; done; exit 1'

[Install]
WantedBy=default.target
